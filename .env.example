# Lovcore Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
#
# SECURITY RULES:
#   - API keys: NO VITE_ prefix (backend only, never exposed to browser)
#   - Non-secret config: VITE_ prefix (accessible to frontend)

# --- Backend AI Provider Keys (NO VITE_ prefix) ---

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# --- Bailian Model Routing (backend reads these) ---

BAILIAN_MODEL_FAST=qwen-turbo
BAILIAN_MODEL_BALANCED=qwen-turbo
BAILIAN_MODEL_STRONG=qwen3.6-max-preview
BAILIAN_MODEL_CODER=qwen3-coder-plus
BAILIAN_MODEL_VISION=qwen3-vl-plus
BAILIAN_MODEL_VISION_FAST=qwen3-vl-flash
BAILIAN_MODEL_ASR_REALTIME=fun-asr-realtime
BAILIAN_MODEL_ASR_FILE=qwen3-asr-flash
BAILIAN_MODEL_ASR_CONTEXT_REALTIME=qwen3.5-omni-plus-realtime
BAILIAN_MODEL_ASR_CONTEXT_FILE=qwen3.5-omni-plus

# --- Frontend Config (VITE_ prefix = accessible in browser) ---

# API base URL for the frontend AI client to call
VITE_API_BASE_URL=/api

# Optional: long-running realtime ASR websocket service.
# Leave empty to use the local Vite dev websocket fallback.
VITE_REALTIME_ASR_URL=

# Supabase (required for cloud sync & auth; leave empty for local-only mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Error Monitoring ---

# Sentry DSN — get from https://sentry.io after creating a project
# Frontend (VITE_ prefix): used by the browser app
VITE_SENTRY_DSN=
# Backend (no prefix): used by Vercel serverless functions
SENTRY_DSN=
